<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <activity-alias
            android:name=".HomeStandaloneLauncher"
            android:enabled="${dashcamStandaloneLauncherEnabled}"
            android:exported="true"
            android:label="Home"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="cn.anc.dashcam.route.home"
            android:value="cn.anc.dashcam.home.HomeActivity" />
    </application>

</manifest>
