<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.anc.dashcam.feedback" >

    <uses-sdk android:minSdkVersion="24" />

    <application>
        <activity
            android:name="cn.anc.dashcam.feedback.FeedbackActivity"
            android:exported="false" />

        <activity-alias
            android:name="cn.anc.dashcam.feedback.FeedbackStandaloneLauncher"
            android:enabled="false"
            android:exported="true"
            android:label="Feedback"
            android:targetActivity="cn.anc.dashcam.feedback.FeedbackActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="cn.anc.dashcam.route.feedback"
            android:value="cn.anc.dashcam.feedback.FeedbackActivity" />
    </application>

</manifest>