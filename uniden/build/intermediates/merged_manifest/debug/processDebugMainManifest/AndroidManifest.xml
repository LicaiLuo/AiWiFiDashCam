<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.anc.dashcam.uniden"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <permission
        android:name="cn.anc.dashcam.uniden.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="cn.anc.dashcam.uniden.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="cn.anc.dashcam.uniden.UnidenApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_uniden"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_uniden_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.Dashcam.Brand" >
        <activity
            android:name="cn.anc.dashcam.home.HomeActivity"
            android:exported="false" />

        <activity-alias
            android:name="cn.anc.dashcam.home.HomeStandaloneLauncher"
            android:enabled="false"
            android:exported="true"
            android:label="Home"
            android:targetActivity="cn.anc.dashcam.home.HomeActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="cn.anc.dashcam.route.home"
            android:value="cn.anc.dashcam.home.HomeActivity" />

        <activity
            android:name="cn.anc.dashcam.settings.SettingsActivity"
            android:exported="false" />

        <activity-alias
            android:name="cn.anc.dashcam.settings.SettingsStandaloneLauncher"
            android:enabled="false"
            android:exported="true"
            android:label="@string/settings_title"
            android:targetActivity="cn.anc.dashcam.settings.SettingsActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="cn.anc.dashcam.settings.LanguageSettingsActivity"
            android:exported="false" />
        <activity
            android:name="cn.anc.dashcam.settings.ThemeSettingsActivity"
            android:exported="false" />
        <activity
            android:name="cn.anc.dashcam.settings.ThemeColorSettingsActivity"
            android:exported="false" />
        <activity
            android:name="cn.anc.dashcam.settings.StatusBarSettingsActivity"
            android:exported="false" />

        <meta-data
            android:name="cn.anc.dashcam.route.settings"
            android:value="cn.anc.dashcam.settings.SettingsActivity" />

        <activity
            android:name="cn.anc.dashcam.feedback.FeedbackActivity"
            android:exported="false" />

        <activity-alias
            android:name="cn.anc.dashcam.feedback.FeedbackStandaloneLauncher"
            android:enabled="false"
            android:exported="true"
            android:label="Feedback"
            android:targetActivity="cn.anc.dashcam.feedback.FeedbackActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="cn.anc.dashcam.route.feedback"
            android:value="cn.anc.dashcam.feedback.FeedbackActivity" />

        <activity
            android:name="cn.anc.dashcam.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Dashcam.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="cn.anc.dashcam.uniden.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>